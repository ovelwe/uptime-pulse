datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Metric {
  id           String   @id @default(uuid())
  url          String
  statusCode   Int
  responseTime Int
  error        String?
  createdAt    DateTime @default(now())

  @@index([url])
  @@index([createdAt])
}