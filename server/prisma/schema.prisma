generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Metric {
  id           String   @id @default(uuid())
  url          String
  statusCode   Int
  responseTime Int
  error        String?
  createdAt    DateTime @default(now())
}

model Target {
  id        String   @id @default(uuid())
  url       String   @unique
  createdAt DateTime @default(now())
}